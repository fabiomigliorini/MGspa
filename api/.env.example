APP_NAME="MGspa API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Cuiaba
APP_URL=https://api-dev.mgpapelaria.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco compartilhado mgsis
DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=mgsis
DB_USERNAME=mgsis
DB_PASSWORD=mgsis
DB_SCHEMA=mgsis

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=.mgpapelaria.com.br
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Redis (session + cache + queue). REDIS_HOST=redis quando rodando via docker-compose.yaml.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
# Deve ser MAIOR que o $timeout do job mais longo (NFePHPResolverJob = 900s).
# Abaixo disso a fila devolve o job ainda em execucao; com $tries=1 ele falha antes do
# handle() (nao duplica envio a SEFAZ), mas polui tbljobsfailedspa.
# Trade-off: worker morto devolve jobs em 16 min, nao em 1,5 min.
REDIS_QUEUE_RETRY_AFTER=960

# Raiz dos arquivos gerados/recebidos pela biblioteca NFePHP.
# Aponta para NFePHP/ direto — o subdiretorio 'Arquivos/' que existia dentro dele era
# redundante e saiu na reorganizacao. A arvore legada ainda vive em NFePHP/Arquivos/ ate
# a migracao terminar (nfe-php:migrar-arquivos).
NFE_PHP_PATH='/opt/www/Arquivos/NFePHP/'


MAIL_MAILER=log
MAIL_FROM_ADDRESS="naoresponda@mgpapelaria.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Auth (paridade MGAuth — mesmo client UUID do banco mgsis.oauth_clients)
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_COOKIE_DOMAIN=.mgpapelaria.com.br
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=none
AUTH_DEFAULT_REDIRECT=https://sistema-dev.mgpapelaria.com.br


# --- Apps MGspa ---
SISTEMA_URL=https://sistema.mgpapelaria.com.br
NEGOCIOS_URL=https://negocios.mgpapelaria.com.br
NOTAS_URL=https://notas.mgpapelaria.com.br
CONTAS_URL=https://contas.mgpapelaria.com.br
PESSOAS_URL=https://pessoas.mgpapelaria.com.br
ESTOQUE_URL=https://estoque.mgpapelaria.com.br
AGRO_URL=https://agro.mgpapelaria.com.br
